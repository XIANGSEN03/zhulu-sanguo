/* 游戏大厅：中性的灰底，两张卡片各用自己游戏的配色 */
@import "/common/font.wxss";

page {
  --bg: #E4E1DA; --text: #1E2321; --dim: #6A6E68;
  --tent: #141C1E; --silk: #D7C59F; --silk-hi: #EADCB8; --seal: #B53F2B; --bronze: #C9A066;
  --wei: #4A78A8; --yuan: #C29330; --wu: #C04E37; --shu: #4C9361;
  --sk-bg: #D5DEDB; --sk-ink: #202B25; --sk-yellow: #F1B900; --sk-crate: #B57B44; --sk-wall: #3E4C44;
  --brush: 'ZLBrush', 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
.brush { font-family: var(--brush); font-weight: normal; }
.home { min-height: 100vh; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; gap: 14px; }
.head { display: flex; align-items: center; }
.eyebrow { font-size: 13px; letter-spacing: 4px; color: var(--dim); font-weight: 600; }
.h1 { font-size: 28px; font-weight: 800; letter-spacing: 1px; margin: 2px 0 6px; }
.card { border-radius: 18px; padding: 18px 18px 16px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 18px 36px -22px rgba(20, 25, 22, .55); transition: transform .12s; }
.press { transform: scale(.985); }
.go { font-size: 26px; line-height: 1; font-weight: 300; }

/* 逐鹿三国：深色军帐 */
.zl { background: var(--tent); color: var(--silk-hi); }
.zl-top { display: flex; align-items: center; gap: 10px; }
.zl-name { font-size: 64px; line-height: 1; letter-spacing: 3px; }
.zl-seal { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 32px; height: 60px; border-radius: 4px; background: var(--seal); color: var(--silk-hi); font-size: 20px; line-height: 1.05; transform: rotate(4deg); }
.flags { margin-left: auto; display: flex; gap: 6px; align-self: flex-start; }
.flag { width: 22px; height: 26px; padding-bottom: 4px; display: flex; align-items: center; justify-content: center; background: var(--fc); color: var(--silk-hi); font-family: var(--brush); font-size: 15px; line-height: 1; -webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 84%, 0 100%); opacity: .55; }
.flag.mine { opacity: 1; transform: translateY(-3px); }
.f-wei { --fc: var(--wei); } .f-yuan { --fc: var(--yuan); } .f-wu { --fc: var(--wu); } .f-shu { --fc: var(--shu); }
.zl-tag { font-size: 13px; letter-spacing: 3px; color: var(--bronze); }
.zl-desc { font-size: 13.5px; line-height: 1.7; color: rgba(234, 220, 184, .72); }
.zl-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px; padding-top: 12px; border-top: 1px solid rgba(234, 220, 184, .14); }
.zl-state { font-size: 14px; font-weight: 600; }

/* 推箱子：浅灰绿仓库 */
.sk { background: var(--sk-bg); color: var(--sk-ink); }
.sk-top { display: flex; align-items: center; gap: 8px; }
.sk-name { font-size: 26px; font-weight: 800; letter-spacing: 1px; }
.sk-badge { background: var(--sk-yellow); color: var(--sk-ink); padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 800; }
.sk-tag { font-size: 13px; color: #55645B; }
.sk-art { display: flex; gap: 4px; margin: 6px 0 2px; }
.cell { width: 34px; height: 34px; border-radius: 5px; background: #E9EEEA; display: flex; align-items: center; justify-content: center; }
.cell.wall { background: var(--sk-wall); }
.worker { width: 16px; height: 16px; border-radius: 50%; background: var(--sk-ink); box-shadow: 0 -9px 0 -4px var(--sk-yellow); }
.crate { width: 26px; height: 26px; border-radius: 3px; background: var(--sk-crate); box-shadow: inset 0 0 0 2px rgba(0, 0, 0, .18), inset 11px 0 0 -9px rgba(255, 236, 190, .9); }
.arrow { font-size: 24px; font-weight: 800; color: #7A8A80; line-height: 1; }
.spot { width: 26px; height: 26px; border: 2.5px dashed var(--sk-yellow); border-radius: 3px; }
.sk-foot { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
.sk-bar { height: 5px; border-radius: 3px; background: rgba(32, 43, 37, .12); overflow: hidden; }
.sk-bar-i { height: 100%; background: #2E9A58; }
.sk-row { display: flex; align-items: center; justify-content: space-between; }
.sk-state { font-size: 14px; font-weight: 600; }

.note { font-size: 12px; color: var(--dim); text-align: center; margin-top: 6px; }
