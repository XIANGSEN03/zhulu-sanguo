/* 以下几行原在推箱子的 app.wxss，合并进游戏合集后改为只作用于本页 */
page { height: 100%; background: #d5dedb; color: #202b25; font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif; }
view, button, scroll-view { box-sizing: border-box; }
button { width: auto; min-width: 0; margin: 0; padding: 0; font-size: 14px; line-height: 1.4; border-radius: 9px; color: #202b25; background: transparent; }
button::after { border: none; }
button[disabled] { color: #919b95; background: #e5e9e5; }
.button-hover { opacity: .72; }
.back { width: 30px; height: 32px; margin-left: -4px; display: flex; align-items: center; justify-content: center; font-size: 32px; line-height: 1; font-weight: 300; }
.back-hover { opacity: .55; }
.game-page { position: fixed; inset: 0; overflow: hidden; }
.scene { position: fixed; left: 0; width: 100%; display: block; z-index: 0; border-radius: 10px; }
.hud-header { position: fixed; top: 0; left: 0; right: 0; padding-left: 12px; padding-right: 12px; z-index: 2; background: linear-gradient(180deg, rgba(230,236,230,.97), rgba(230,236,230,.82) 26%, rgba(230,236,230,0) 54%); }
.title-row { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }
.title { font-size: 22px; font-weight: 700; letter-spacing: 1px; text-shadow: 0 1px 8px rgba(255,255,255,.85); }
.badge { background: #f1b900; color: #202b25; padding: 2px 5px; border-radius: 4px; font-size: 11px; font-weight: 700; }
.panel { background: rgba(248,249,246,.94); border: 1px solid rgba(28,35,32,.12); border-radius: 10px; box-shadow: 0 7px 22px rgba(10,20,15,.16); }
.order-panel { padding: 9px 12px 10px; margin-bottom: 7px; }
.order-line { display: flex; align-items: baseline; gap: 9px; }
.eyebrow { font-size: 11px; color: #647169; letter-spacing: 1px; }
.order-no { font-size: 19px; font-weight: 700; font-family: Arial, sans-serif; }
.order-name { font-size: 14px; font-weight: 600; }
.stats { display: flex; margin-top: 6px; }
.stat { display: flex; flex-direction: column; width: 25%; }
.stat-label { color: #647169; font-size: 11px; }
.stat-value { font-family: Arial, sans-serif; font-size: 22px; line-height: 1.15; font-weight: 700; }
.done { color: #2e9a58; }
.tools { display: flex; gap: 3px; padding: 4px; }
.tool { flex: 1; min-width: 0; display: flex; justify-content: center; align-items: center; font-size: 13px; height: 35px; white-space: nowrap; }
.tool.selected { color: #f7f9f5; background: #26372d; }
.hud-footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 2; padding: 0 12px; display: flex; align-items: center; flex-direction: column; gap: 8px; }
.actions { display: flex; width: 100%; max-width: 420px; padding: 4px; }
.actions button { flex: 1; height: 37px; display: flex; align-items: center; justify-content: center; }
.dpad { width: 195px; flex-shrink: 0; padding: 7px; display: flex; flex-direction: column; gap: 5px; }
.dpad-row { display: flex; justify-content: center; gap: 5px; }
.dir { flex: 0 0 57px; min-width: 57px; width: 57px; height: 46px; display: flex; align-items: center; justify-content: center; background: #d7ddd8; font-size: 27px; font-family: Arial, sans-serif; font-weight: 600; touch-action: none; }
.footer-note { display: flex; align-items: center; gap: 8px; font-size: 10px; color: #55645b; background: rgba(248,249,246,.94); border-radius: 6px; padding: 0 8px; }
.reset-view { font-size: 10px; color: #334e3c; padding: 3px 0; text-decoration: underline; }
.toast { width: 100%; background: #f7f9f5; border-left: 4px solid #f1b900; border-radius: 7px; box-shadow: 0 4px 18px rgba(10,20,15,.16); padding: 9px 12px; font-size: 13px; line-height: 1.6; }
.scenic-actions { display: flex; align-items: center; flex-direction: column; gap: 10px; }
.scenic-tip { background: rgba(248,249,246,.9); border-radius: 6px; padding: 4px 10px; font-size: 12px; }
.scenic-back { padding: 10px 25px; }
.primary { background: #f1b900; color: #202b25; font-weight: 600; }
.overlay { position: fixed; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; padding: 22px 16px; background: rgba(20,26,24,.48); }
.sheet-card { display: flex; flex-direction: column; width: 100%; max-width: 560px; height: 70vh; max-height: 620px; background: #f7f9f5; border-radius: 12px; box-shadow: 0 15px 45px rgba(0,0,0,.24); overflow: hidden; }
.sheet-head { display: flex; align-items: center; gap: 10px; padding: 14px 14px 11px; border-bottom: 1px solid #dde3dd; flex-shrink: 0; }
.sheet-title { font-size: 23px; font-weight: 700; }
.progress { flex: 1; font-size: 12px; color: #647169; }
.close { font-size: 13px; border: 1px solid #d6ded6; padding: 6px 10px; }
.orders { flex: 1; width: 100%; height: 0; padding: 6px 7px 9px; }
.order-button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 9px; text-align: left; }
.order-button.current { background: #e6ece6; border-left: 3px solid #f1b900; }
.list-no { flex: 0 0 58px; width: 58px; font-size: 16px; font-weight: 700; font-family: Arial, sans-serif; }
.list-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.list-name { font-size: 14px; font-weight: 600; }
.list-best { font-size: 11px; color: #647169; }
.list-stars { color: #e3a500; font-size: 15px; }
.win-card { position: relative; width: 100%; max-width: 360px; background: #f7f9f5; border-radius: 12px; padding: 20px; box-shadow: 0 15px 45px rgba(0,0,0,.24); }
.win-order { display: block; font-size: 12px; color: #647169; }
.win-title { display: block; margin-top: 3px; font-size: 27px; font-weight: 700; padding-right: 95px; }
.stamp { position: absolute; top: 18px; right: 18px; border: 3px solid #c23a2b; color: #c23a2b; border-radius: 6px; padding: 4px 8px 3px; transform: rotate(-10deg); display: flex; flex-direction: column; align-items: center; font-size: 23px; line-height: 1.05; }
.stamp-date { font-size: 10px; font-family: Arial, sans-serif; margin-top: 2px; }
.win-figures { display: flex; gap: 12px; margin: 22px 0 12px; }
.figure { display: flex; flex-direction: column; flex: 1; border-top: 2px solid #25382c; padding-top: 6px; }
.figure-label { color: #647169; font-size: 12px; }
.figure-value { font-family: Arial, sans-serif; font-size: 31px; font-weight: 700; }
.rating { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; }
.stars { color: #e9ac00; font-size: 25px; letter-spacing: 2px; }
.win-note { display: block; color: #647169; font-size: 13px; margin: 7px 0 18px; line-height: 1.6; }
.win-actions { display: flex; gap: 6px; }
.win-actions button { flex: 1; padding: 9px 4px; border: 1px solid #d6ded6; font-size: 13px; }
.win-actions button.primary { border-color: #f1b900; }
.win-undo { color: #647169; font-size: 11px; margin-top: 12px; padding: 3px; }
.loading-mask { position: fixed; inset: 0; z-index: 6; background: rgba(213,222,219,.75); display: flex; justify-content: center; align-items: center; padding: 25px; }
.loading-card { padding: 22px; max-width: 350px; display: flex; flex-direction: column; gap: 10px; }
.loading-title { font-size: 21px; font-weight: 700; }
.loading-message { font-size: 14px; color: #647169; line-height: 1.7; }
@media (max-height: 650px) {
  .order-panel { padding: 6px 10px; }
  .stat-value { font-size: 19px; }
  .title-row { margin-bottom: 5px; }
  .order-line { gap: 7px; }
  .order-no { font-size: 17px; }
  .stats { margin-top: 3px; }
  .tool { height: 28px; font-size: 12px; }
  .hud-footer { gap: 5px; }
  .dpad { width: 180px; }
  .dir { height: 38px; width: 52px; min-width: 52px; flex-basis: 52px; }
  .actions button { height: 32px; }
}
